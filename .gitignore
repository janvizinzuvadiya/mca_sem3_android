# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio IDE files
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml

# Keystore files (security sensitive)
*.jks
*.keystore

# External native build folder (Android Studio 2.2+)
.externalNativeBuild
.cxx/

# Google Services (Firebase, etc.)
google-services.json

# Lint outputs
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# OS-specific files
.DS_Store
Thumbs.db

# Version control
vcs.xml

# Fastlane (if used)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
